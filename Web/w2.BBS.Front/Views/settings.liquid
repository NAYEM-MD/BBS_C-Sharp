{% _layout 'layout.liquid' %}

{% _area title %}設定{% end_area %}

{% _area head_resource %}
{% end_area %}

{% _area page_body %}
  <vue-settings
    login-id="{{ LoginId }}"
    initial-user-name="{{ UserName }}">
  </vue-settings>
{% end_area %}

{% _area component %}
<script type="text/x-template" id="vue-settings">
  <div>
    <h1>設定</h1>
    <p v-if="errorMessage" style="color:red">${ errorMessage }</p>
    <p v-if="successMessage" style="color:green">${ successMessage }</p>

    <h2>会員情報の編集</h2>
    <div>
      <label>ログインID</label>
      <input type="text" :value="loginId" readonly />
    </div>
    <div>
      <label>ユーザー名</label>
      <input type="text" v-model="userName" />
    </div>
    <div>
      <label>新しいパスワード</label>
      <input type="password" v-model="password" />
    </div>
    <div>
      <button type="button" @click="saveSettings()">更新</button>
    </div>

    <h2>退会</h2>
    <div>
      <button type="button" @click="withdrawAccount()">退会する</button>
    </div>

    <div>
      <a href="/forum">掲示板へ戻る</a>
    </div>
  </div>
</script>
{% end_area %}

<script>
  {% _javascript key: "onload" %}
  g_vueManager.setComponent('vue-settings', {
    template: '#vue-settings',
    props: {
      loginId: {
        type: String,
        required: true,
      },
      initialUserName: {
        type: String,
        default: '',
      },
    },
    data() {
      return {
        userName: this.initialUserName,
        password: '',
        errorMessage: null,
        successMessage: null,
      }
    },
    methods: {
      saveSettings: function () {
        this.errorMessage = null;
        this.successMessage = null;

        return fetch(window.apiRoot + '/settings', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: new URLSearchParams({
            userName: this.userName,
            password: this.password,
          }),
        })
        .then(response => response.json())
        .then(data => {
          if (data.Success) {
            this.successMessage = data.Message;
            this.password = '';
            if (data.UserName) {
              this.userName = data.UserName;
            }
          } else if (data.RedirectUrl) {
            location.href = data.RedirectUrl;
          } else {
            this.errorMessage = data.Message;
          }
        })
        .catch(() => {
          this.errorMessage = 'エラーが発生しました。';
        });
      },

      withdrawAccount: function () {
        if (confirm('退会しますか？') === false) {
          return;
        }

        this.errorMessage = null;

        return fetch(window.apiRoot + '/settings/withdraw', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: new URLSearchParams({}),
        })
        .then(response => response.json())
        .then(data => {
          if (data.Success) {
            location.href = data.RedirectUrl;
          } else if (data.RedirectUrl) {
            location.href = data.RedirectUrl;
          } else {
            this.errorMessage = data.Message;
          }
        })
        .catch(() => {
          this.errorMessage = 'エラーが発生しました。';
        });
      },
    },
  });
  {% end_javascript %}
</script>
